# Each role may use mock, openai, anthropic, or bedrock.
LEAD_PROVIDER=mock
RESEARCHER_PROVIDER=mock
REVIEWER_PROVIDER=mock

# Optional overrides for the seven-person team. If omitted, Marlow/Kit/Wren use
# LEAD_*, Juniper/Piper use RESEARCHER_*, and Rowan/Tove use REVIEWER_*.
MARLOW_PROVIDER=
JUNIPER_PROVIDER=
KIT_PROVIDER=
WREN_PROVIDER=
ROWAN_PROVIDER=
TOVE_PROVIDER=
PIPER_PROVIDER=

# Set a model for each non-mock role. Role settings override provider defaults.
LEAD_MODEL=
RESEARCHER_MODEL=
REVIEWER_MODEL=
MARLOW_MODEL=
JUNIPER_MODEL=
KIT_MODEL=
WREN_MODEL=
ROWAN_MODEL=
TOVE_MODEL=
PIPER_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
BEDROCK_MODEL=

# Only set credentials for providers you select. Bedrock uses the standard AWS credential chain.
OPENAI_API_KEY=
# Optional new artwork via generate_png (billed Images API). Set a supported GPT Image model.
# Existing SVG-to-PNG conversion works locally without this setting or an API key.
AGENT_TEAM_IMAGE_MODEL=
ANTHROPIC_API_KEY=
AWS_REGION=

# Agent loop ceilings. These are intentionally generous enough for repository work.
AGENT_TEAM_MAX_MODEL_ROUNDS=24
AGENT_TEAM_MAX_TOOL_CALLS=40
# Independent tasks (no dependsOn between them) run at the same time, from 1 to 4.
AGENT_TEAM_MAX_PARALLEL_TASKS=2
