# Each role may use mock, openai, anthropic, or bedrock.
LEAD_PROVIDER=mock
RESEARCHER_PROVIDER=mock
REVIEWER_PROVIDER=mock

# Set a model for each non-mock role. Role settings override provider defaults.
LEAD_MODEL=
RESEARCHER_MODEL=
REVIEWER_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
BEDROCK_MODEL=

# Only set credentials for providers you select. Bedrock uses the standard AWS credential chain.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=
